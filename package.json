{
  "name": "song-hub2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Movie and series soundtrack finder built with Next.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "node --env-file=.env.local ./node_modules/prisma/build/index.js generate",
    "db:push": "node --env-file=.env.local scripts/db-push.mjs",
    "db:import-real": "node --env-file=.env.local scripts/import-real-data.mjs",
    "db:import-songs": "node --env-file=.env.local scripts/import-songs-only.mjs"
  },
  "keywords": [
    "nextjs",
    "soundtracks",
    "movies",
    "series"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@tailwindcss/postcss": "^4.2.2",
    "framer-motion": "^12.38.0",
    "gsap": "^3.14.2",
    "next": "^16.2.2",
    "pg": "^8.20.0",
    "prisma": "^7.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.2"
  }
}
